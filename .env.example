# Backend
ROCKFALL_HOST=0.0.0.0
ROCKFALL_PORT=8000
ROCKFALL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROCKFALL_LOG_LEVEL=INFO
MODEL_PATH=ml/models/rockfall_pipeline.joblib

# Optional map overlay (OpenStreetMap works without a key).
# If you later add a commercial map provider, put the key here — never hard-code it.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_API_BASE_URL=http://127.0.0.1:8000
